{
	"name": "@zoisythe/codex-lsp",
	"version": "0.2.0",
	"description": "Standalone Codex plugin that exposes Language Server Protocol tools and post-edit diagnostics.",
	"type": "module",
	"packageManager": "npm@11.12.1",
	"license": "MIT",
	"homepage": "https://github.com/zoisythe/codex-lsp-standalone",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zoisythe/codex-lsp-standalone.git"
	},
	"bugs": {
		"url": "https://github.com/zoisythe/codex-lsp-standalone/issues"
	},
	"keywords": [
		"codex",
		"codex-plugin",
		"lsp",
		"language-server-protocol",
		"mcp",
		"diagnostics"
	],
	"bin": {
		"codex-lsp": "./dist/cli.js"
	},
	"files": [
		"dist",
		"hooks",
		"skills",
		".codex-plugin",
		".mcp.json",
		"LICENSE",
		"NOTICE",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"bootstrap": "node scripts/bootstrap-submodule.mjs",
		"prebuild": "node scripts/bootstrap-submodule.mjs",
		"build": "node ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
		"pretest": "node scripts/bootstrap-submodule.mjs",
		"test": "node ./node_modules/vitest/vitest.mjs --run",
		"test:watch": "node ./node_modules/vitest/vitest.mjs",
		"pretypecheck": "node scripts/bootstrap-submodule.mjs",
		"typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
		"lint": "node ./node_modules/@biomejs/biome/bin/biome check src test",
		"lint:fix": "node ./node_modules/@biomejs/biome/bin/biome check --write src test",
		"precheck": "node scripts/bootstrap-submodule.mjs",
		"check": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/@biomejs/biome/bin/biome check src test && node ./node_modules/typescript/bin/tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"@code-yeongyu/lsp-tools-mcp": "file:./packages/lsp-tools-mcp"
	},
	"optionalDependencies": {
		"smol-toml": "^1.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/node": "^26.4.1",
		"typescript": "7.0.2",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=24.20.0"
	}
}
